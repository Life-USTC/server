{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-ustc.example/specifications/mutation-capabilities.schema.json",
  "title": "Cross-transport mutation capability bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "schemaVersion",
    "scope",
    "excludedFamilies",
    "capabilities"
  ],
  "properties": {
    "kind": {
      "const": "mutation-capabilities"
    },
    "id": {
      "const": "mutation-capabilities"
    },
    "schemaVersion": {
      "const": 2
    },
    "scope": {
      "$ref": "#/$defs/text"
    },
    "excludedFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "reason": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rest", "graphql", "mcp", "semantics"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(workspace|community)_[a-z0-9_]+$"
        },
        "rest": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(POST|PUT|PATCH|DELETE) /api/[^\\s]+$"
          }
        },
        "graphql": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "field"],
              "properties": {
                "status": {
                  "const": "stable"
                },
                "field": {
                  "type": "string",
                  "pattern": "^[_A-Za-z][_0-9A-Za-z]*$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "field"],
              "properties": {
                "status": {
                  "const": "intentional_gap"
                },
                "field": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tools"],
          "properties": {
            "status": {
              "enum": [
                "native",
                "single_item_only",
                "partial",
                "registered_operation",
                "native_and_registered",
                "unavailable"
              ]
            },
            "tools": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "tools": {
                    "maxItems": 0,
                    "type": "array"
                  }
                }
              },
              "else": {
                "properties": {
                  "tools": {
                    "minItems": 1,
                    "type": "array"
                  }
                }
              }
            }
          ]
        },
        "semantics": {
          "enum": [
            "single",
            "per_item_partial",
            "single_idempotent",
            "atomic",
            "single_audited",
            "single_audited_idempotent",
            "ordered_non_atomic",
            "multi_step_storage_workflow",
            "single_owned_write",
            "storage_then_transactional_metadata_delete",
            "transport_only"
          ]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "batch_contract": {
          "$ref": "#/$defs/batchContract"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "graphql": {
                "properties": {
                  "status": {
                    "const": "intentional_gap"
                  }
                },
                "type": "object"
              }
            }
          },
          "then": {
            "required": ["notes"],
            "properties": {
              "notes": {}
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "semantics": {
                    "enum": ["per_item_partial", "atomic", "ordered_non_atomic"]
                  }
                }
              },
              {
                "properties": {
                  "id": {
                    "const": "workspace_subscription_internal_ids_append_remove"
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "batch_contract": {
                "$ref": "#/$defs/batchContract"
              }
            },
            "required": ["batch_contract"]
          },
          "else": {
            "properties": {
              "batch_contract": false
            }
          }
        }
      ]
    },
    "batchContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "results",
        "atomicity",
        "invalid_targets",
        "retry",
        "requirement_refs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface",
              "identifiers",
              "duplicates",
              "max_items",
              "limit_basis"
            ],
            "properties": {
              "surface": {
                "enum": ["rest", "graphql", "mcp-native", "mcp-registered"]
              },
              "identifiers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "todo_id",
                    "homework_id",
                    "comment_id",
                    "internal_section_id",
                    "section_or_course_code",
                    "catalog_link_slug"
                  ]
                }
              },
              "duplicates": {
                "enum": [
                  "reject_normalized",
                  "deduplicate_normalized",
                  "execute_in_order"
                ]
              },
              "max_items": {
                "type": "integer",
                "minimum": 1
              },
              "limit_basis": {
                "const": "each_raw_input_array"
              }
            }
          }
        },
        "results": {
          "enum": [
            "ordered_per_item",
            "aggregate_matches",
            "final_collection",
            "success"
          ]
        },
        "atomicity": {
          "enum": [
            "independent_items",
            "accepted_items_transaction",
            "ordered_prefix"
          ]
        },
        "invalid_targets": {
          "enum": [
            "per_item_error",
            "omit_or_report_unmatched",
            "reject_before_write"
          ]
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desired_state", "response", "after_uncertain_result"],
          "properties": {
            "desired_state": {
              "const": "idempotent"
            },
            "response": {
              "enum": ["may_change", "same_for_unchanged_targets"]
            },
            "after_uncertain_result": {
              "const": "inspect_state_before_replay"
            }
          }
        },
        "requirement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+$"
          }
        }
      }
    }
  }
}
