{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-ustc.example/specifications/defs.schema.json",
  "title": "Shared product specification definitions",
  "$defs": {
    "shortText": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "text": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "compactStringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "permission": {
      "type": "string",
      "enum": ["read", "write", "update", "delete", "moderate", "manage"]
    },
    "roleDefinition": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "base_permissions"],
          "properties": {
            "description": {
              "$ref": "#/$defs/text"
            },
            "base_permissions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/permission"
              }
            },
            "scope": {
              "$ref": "#/$defs/text"
            },
            "inherits": {
              "$ref": "#/$defs/shortText"
            },
            "notes": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "accessEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["permissions"],
          "properties": {
            "permissions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/permission"
              }
            },
            "scope": {
              "$ref": "#/$defs/text"
            },
            "notes": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "authLevel": {
      "type": "string",
      "enum": ["anon", "user", "admin", "internal"]
    },
    "surfaceStatus": {
      "type": "string",
      "enum": ["stable", "planned", "unavailable"]
    },
    "routeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "auth": {
          "$ref": "#/$defs/authLevel"
        },
        "reference_only": {
          "type": "boolean",
          "const": true
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "if": {
        "properties": {
          "reference_only": {
            "const": true
          }
        },
        "required": ["reference_only"]
      },
      "then": {
        "properties": {
          "description": false,
          "content_type": false,
          "status": false,
          "auth": false,
          "notes": false
        }
      }
    },
    "toolEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "$ref": "#/$defs/surfaceStatus"
        },
        "auth": {
          "$ref": "#/$defs/authLevel"
        },
        "rest_equivalent": {
          "type": "string",
          "pattern": "^(GET|POST|PUT|PATCH|DELETE) /"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "rest_equivalent": false
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "modelRef": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9]*$"
            },
            "role": {
              "type": "string",
              "enum": ["primary", "context"]
            }
          }
        }
      ]
    },
    "toolGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tools"],
      "properties": {
        "name": {
          "$ref": "#/$defs/shortText"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "resourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uri", "mime_type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "uri": {
          "type": "string",
          "pattern": "^life-ustc://"
        },
        "mime_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "auth": {
          "$ref": "#/$defs/authLevel"
        }
      }
    },
    "promptEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "auth": {
          "$ref": "#/$defs/authLevel"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/modelRef"
          }
        },
        "ui": {
          "$ref": "#/$defs/compactStringList"
        }
      }
    },
    "webSurface": {
      "oneOf": [
        {
          "$ref": "#/$defs/surfaceStatus"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pages"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["stable", "planned"]
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        }
      ]
    },
    "restSurface": {
      "oneOf": [
        {
          "$ref": "#/$defs/surfaceStatus"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["routes"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["stable", "planned"]
            },
            "routes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/routeEntry"
              }
            }
          }
        }
      ]
    },
    "graphqlFieldEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "parent": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "$ref": "#/$defs/surfaceStatus"
        },
        "auth": {
          "$ref": "#/$defs/authLevel"
        },
        "required_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*:(read|write)$"
          }
        },
        "rest_equivalent": {
          "type": "string",
          "pattern": "^(GET|POST|PUT|PATCH|DELETE) /"
        },
        "mcp_equivalent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "graphqlSurface": {
      "oneOf": [
        {
          "$ref": "#/$defs/surfaceStatus"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {
              "required": ["queries"],
              "properties": {
                "queries": true
              }
            },
            {
              "required": ["mutations"],
              "properties": {
                "mutations": true
              }
            },
            {
              "required": ["fields"],
              "properties": {
                "fields": true
              }
            }
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["stable", "planned"]
            },
            "queries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/graphqlFieldEntry"
              }
            },
            "mutations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/graphqlFieldEntry"
              }
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/graphqlFieldEntry"
              }
            }
          }
        }
      ]
    },
    "mcpSurface": {
      "oneOf": [
        {
          "$ref": "#/$defs/surfaceStatus"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {
              "required": ["tools"],
              "properties": {
                "tools": true
              }
            },
            {
              "required": ["groups"],
              "properties": {
                "groups": true
              }
            },
            {
              "required": ["resources"],
              "properties": {
                "resources": true
              }
            },
            {
              "required": ["prompts"],
              "properties": {
                "prompts": true
              }
            }
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["stable", "planned"]
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/toolEntry"
              }
            },
            "groups": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/toolGroup"
              }
            },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/resourceEntry"
              }
            },
            "prompts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/promptEntry"
              }
            }
          }
        }
      ]
    },
    "moduleAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anon", "user", "admin", "agent"],
      "properties": {
        "anon": {
          "$ref": "#/$defs/accessEntry"
        },
        "user": {
          "$ref": "#/$defs/accessEntry"
        },
        "admin": {
          "$ref": "#/$defs/accessEntry"
        },
        "agent": {
          "$ref": "#/$defs/accessEntry"
        }
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)*$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "policyRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "surface": {
      "type": "string",
      "enum": ["web", "rest", "graphql", "mcp", "cli", "bot", "ios"]
    },
    "testReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "name"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^tests/[^\\s]+$"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "given", "when", "then"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "given": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "when": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "then": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/testReference"
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "rule"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "type": "string",
          "enum": [
            "behavior",
            "authorization",
            "presentation",
            "consistency",
            "validation",
            "privacy"
          ]
        },
        "rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "topic": {
          "$ref": "#/$defs/localId"
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/surface"
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "description": "Ordered presentation requirements, not a data-field schema. An empty list means this specification only defines filters."
        },
        "filters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
