{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-ustc.example/specifications/policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "policy"
    },
    "id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "title": {
      "$ref": "defs.schema.json#/$defs/nonEmptyString"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/requirement"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "policy_refs": {
      "$ref": "defs.schema.json#/$defs/policyRefs"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "feature": {
            "$ref": "defs.schema.json#/$defs/id"
          },
          "capability": {
            "$ref": "defs.schema.json#/$defs/id"
          }
        },
        "required": ["feature"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "defs.schema.json#/$defs/localId"
          },
          "description": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          }
        },
        "required": ["id", "description"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "defs.schema.json#/$defs/localId"
          },
          "title": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          }
        },
        "required": ["id", "title"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "audit_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "trigger": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "description": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "requirement_refs": {
            "$ref": "defs.schema.json#/$defs/requirementRefs"
          }
        },
        "required": ["action", "trigger", "description"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "defs.schema.json#/$defs/localId"
          },
          "owns": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "excludes": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          }
        },
        "required": ["id", "owns", "excludes"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "meaning": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          }
        },
        "required": ["name", "meaning"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "surface_forms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "surface": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "form": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "example": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          }
        },
        "required": ["surface", "form", "example"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "meaning": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          }
        },
        "required": ["action", "meaning"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "surface_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "web": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "rest": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "graphql": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "bot": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "cli": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          }
        },
        "required": ["capability", "web", "rest", "graphql", "bot", "cli"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "hierarchy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "description": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          }
        },
        "required": ["path"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "graphql_roots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mutation_prefixes": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["query", "mutation_prefixes"]
    },
    "cache_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "defs.schema.json#/$defs/id"
          },
          "representations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cacheRepresentation"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "layers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cacheLayer"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "invalidators": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cacheInvalidator"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "$ref": "defs.schema.json#/$defs/nonEmptyString"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "rationale": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          }
        },
        "required": [
          "id",
          "representations",
          "layers",
          "invalidators",
          "requirement_refs"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enforcement": {
      "enum": ["advisory"]
    },
    "title_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "when": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "example": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          }
        },
        "required": ["pattern", "when", "example"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "avoid_examples": {
      "type": "array",
      "items": {
        "$ref": "defs.schema.json#/$defs/nonEmptyString"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "description_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "required": {
            "type": "boolean"
          },
          "unknown": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "examples": {
            "type": "array",
            "items": {
              "$ref": "defs.schema.json#/$defs/nonEmptyString"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": ["label", "required"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {
            "$ref": "defs.schema.json#/$defs/localId"
          },
          "title": {
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "requirement_refs": {
            "$ref": "defs.schema.json#/$defs/requirementRefs"
          }
        }
      },
      "uniqueItems": true
    },
    "rationale": {
      "$ref": "defs.schema.json#/$defs/notes"
    },
    "guidance": {
      "$ref": "defs.schema.json#/$defs/notes"
    }
  },
  "required": ["kind", "id", "title", "requirements", "topics"],
  "allOf": [
    {
      "if": {
        "required": ["enforcement"],
        "properties": {
          "enforcement": {
            "const": "advisory"
          }
        }
      },
      "then": {
        "properties": {
          "requirements": {
            "type": "array",
            "maxItems": 0
          },
          "guidance": true
        },
        "required": ["guidance"]
      },
      "else": {
        "properties": {
          "requirements": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "cacheFreshness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ttl"
            },
            "fresh_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "stale_seconds": {
              "type": "integer",
              "minimum": 0,
              "description": "Additional permitted age after fresh_seconds; maximum total age is their sum."
            },
            "stale_use": {
              "enum": [
                "none",
                "while_revalidate",
                "async_rebuild",
                "refresh_contention"
              ]
            },
            "age_from": {
              "enum": [
                "cache_entry",
                "http_response",
                "snapshot_fetched_at",
                "export_generated_at",
                "metric_collected_at"
              ]
            },
            "expires_when": {
              "enum": ["gte", "gt"],
              "description": "Comparison of age to each boundary: fresh_seconds for freshness, and fresh_seconds plus stale_seconds for final eligibility."
            }
          },
          "required": [
            "kind",
            "fresh_seconds",
            "stale_seconds",
            "stale_use",
            "age_from",
            "expires_when"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "stale_seconds": {
                    "const": 0
                  }
                },
                "required": ["stale_seconds"]
              },
              "then": {
                "properties": {
                  "stale_use": {
                    "const": "none"
                  }
                }
              },
              "else": {
                "properties": {
                  "stale_use": {
                    "enum": [
                      "while_revalidate",
                      "async_rebuild",
                      "refresh_contention"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "request",
                "build",
                "retained",
                "no_store",
                "must_revalidate",
                "until_clock_boundary"
              ]
            }
          },
          "required": ["kind"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "immutable"
            },
            "fresh_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["kind", "fresh_seconds"]
        }
      ]
    },
    "cacheClockBoundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "shanghai_midnight"
            },
            "timezone": {
              "const": "Asia/Shanghai"
            },
            "effect": {
              "const": "key_change"
            }
          },
          "required": ["kind", "timezone", "effect"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "shanghai_midnight"
            },
            "timezone": {
              "const": "Asia/Shanghai"
            },
            "effect": {
              "const": "expire"
            },
            "rounding": {
              "const": "floor"
            },
            "minimum_seconds": {
              "const": 1
            }
          },
          "required": [
            "kind",
            "timezone",
            "effect",
            "rounding",
            "minimum_seconds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "render_crosses_midnight"
            },
            "timezone": {
              "const": "Asia/Shanghai"
            },
            "effect": {
              "const": "no_store"
            }
          },
          "required": ["kind", "timezone", "effect"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "request_time"
            },
            "effect": {
              "const": "recompute"
            }
          },
          "required": ["kind", "effect"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "periodic_revalidation",
                "storage_expiry",
                "refresh_coalescing"
              ]
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["kind", "seconds"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["invalid_timestamp", "future_timestamp"]
            },
            "effect": {
              "const": "refresh"
            }
          },
          "required": ["kind", "effect"]
        }
      ]
    },
    "cacheLayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/cacheLayerKind"
        },
        "representations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cacheRepresentation"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "freshness": {
          "$ref": "#/$defs/cacheFreshness"
        },
        "key_dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "accept_language",
              "asset_url",
              "avatar_id",
              "build",
              "cookie",
              "entity",
              "feed_credential",
              "filters",
              "import_revision",
              "limit",
              "locale",
              "location",
              "media_url_hash",
              "metric_snapshot",
              "normalized_query",
              "object_key",
              "origin",
              "owner",
              "page",
              "poster_path",
              "publication",
              "request",
              "revision",
              "room_code",
              "service_date",
              "shanghai_date",
              "shape",
              "timetable_version",
              "url",
              "viewer"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "clock_boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cacheClockBoundary"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "representations",
        "freshness",
        "key_dimensions",
        "clock_boundaries"
      ]
    },
    "cacheInvalidator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "enum": [
            "account_delete",
            "avatar_reference_removal",
            "calendar_source_commit",
            "community_commit",
            "deployment",
            "description_commit",
            "description_moderation",
            "external_asset_update",
            "feed_credential_rotation",
            "media_url_change",
            "metric_refresh",
            "owner_state_commit",
            "poster_path_change",
            "profile_update",
            "publication_ingest",
            "publication_withdrawal",
            "static_import_commit",
            "weather_refresh"
          ]
        },
        "effect": {
          "enum": [
            "deny_before_cache",
            "enqueue_rebuild",
            "key_change",
            "next_request",
            "purge",
            "refetch_after_expiry",
            "replace_value"
          ]
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cacheLayerKind"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "representations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cacheRepresentation"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["trigger", "effect", "layers", "representations"]
    },
    "cacheLayerKind": {
      "enum": [
        "application_build",
        "browser",
        "calendar_kv",
        "catalog_kv",
        "colo_cache_api",
        "database_metric_cache",
        "graphql_dataloader",
        "isolate_memory",
        "object_storage",
        "request_authorization",
        "request_database",
        "request_projection",
        "serving_process",
        "weather_kv",
        "workers_entrypoint",
        "zone_cdn"
      ]
    },
    "cacheRepresentation": {
      "enum": [
        "academic_detail_cores",
        "academic_json",
        "academic_list_and_course_teacher_html",
        "academic_list_facts",
        "academic_metadata_json",
        "attachment_metadata",
        "avatar_bytes",
        "building_image_rules",
        "bus_page_departures",
        "bus_route_search_json",
        "bus_timetable_facts",
        "campus_link_definitions",
        "campus_links_html",
        "comments",
        "current_semester",
        "description_history",
        "descriptions",
        "graphql_entities",
        "location_coordinates",
        "next_departures",
        "openapi_document",
        "owner_workspace",
        "personal_ics",
        "private_subscribed_homework_search",
        "private_todo_search",
        "profile_contributions",
        "prometheus_gauges",
        "public_contributions",
        "public_profile",
        "public_search_groups",
        "publication_detail_json",
        "publication_image",
        "publication_list_json",
        "publication_object",
        "reactions",
        "room_map_json",
        "room_map_manifest",
        "schedule_facts",
        "section_detail_html",
        "semester_list_json",
        "shared_homework",
        "shell_identity_counts",
        "sign_in_html",
        "sitemap_xml",
        "static_guide_content",
        "static_guides_html",
        "timetable_date_projection",
        "weather_hourly_projection",
        "weather_snapshot",
        "young_calendar_html",
        "young_clock_projection",
        "young_event_facts",
        "young_html",
        "young_json",
        "young_organizer_facts",
        "young_poster_bytes",
        "young_poster_redirect"
      ]
    }
  }
}
