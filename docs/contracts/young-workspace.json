{
  "name": "Young Workspace",
  "access": {
    "anon": "Public catalog and permitted comments only.",
    "user": "Own activity and organizer subscriptions, notifications and personal calendar.",
    "admin": "Same personal capabilities as users.",
    "agent": "Same capabilities through feature-scoped OAuth."
  },
  "rules": {
    "subscription": "Subscribing never registers attendance. Event subscriptions add activity instants to personal calendars and ICS; organizer follows only create daily new-event digests.",
    "ownership": "User identity comes from the authenticated principal; private tables enforce owner RLS. Reads are private/no-store.",
    "reminders": "Signup opening after subscription, deadline 24h before, event start 1h before, each independently configurable. Scheduled generation every 10 minutes and refresh on notification listing. Expired reminders excluded; important activity changes refresh calendar export and remove superseded reminders.",
    "digest": "Previous Shanghai day newly discovered future events, after follow time, grouped per organizer; no retroactive flood and no automatic event subscriptions.",
    "calendar": "Inclusive Shanghai date-only bounds; explicit-offset instants and Shanghai timezone-less datetime bounds, maximum 366 days, paired bounds or default seven-day window. REST/GraphQL paginated; MCP complete unified event list. GraphQL boundary strings share service validation. Unknown event start times are not invented.",
    "history": "Imported events and subscriptions survive source absence. Absence does not imply cancellation."
  },
