{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-ustc-promotion",
  "main": "scripts/deploy/promotion-worker.ts",
  "compatibility_date": "2026-07-23",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PROMOTION_ENABLED": "false",
    "GITHUB_REPOSITORY": "Life-USTC/server",
    "WORKER_NAME": "life-ustc"
  },
  "durable_objects": {
    "bindings": [{ "name": "PROMOTION", "class_name": "ProductionPromotion" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProductionPromotion"] }]
}
