{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "incremental": true,
    // `$app/tsconfig` enables `checkJs`; the previous configuration did not
    // type-check plain .js entrypoints (src/worker.js), so keep that behavior.
    "checkJs": false,
    "types": ["$app/types", "node"],
    // Mirrors the aliases in node_modules/$app/tsconfig.json (generated by
    // `svelte-kit sync`). Bun's runtime cannot follow the package-style
    // `extends: "$app/tsconfig"`, so scripts run with `bun run` need them here.
    "paths": {
      "@/generated/prisma/client": ["./src/generated/prisma/client"],
      "@/generated/prisma/client/*": ["./src/generated/prisma/client/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.svelte", "**/*.mts"],
  "exclude": [
    "node_modules",
    "scripts",
    "tests",
    "tools",
    "playwright.config.ts"
  ]
}
