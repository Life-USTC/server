{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "playwright.config.ts",
    "prisma.config.ts",
    "vitest.base.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "tests/ci/fixtures/e2e-storage-worker.ts",
    "tests/ci/fixtures/isolated-worker-timeout.config.ts",
    "tests/ci/fixtures/isolated-worker-timeout.scenario.ts",
    "tests/ci/fixtures/isolated-database-timeout.config.ts",
    "tests/ci/fixtures/isolated-database-timeout.scenario.ts",
    "tests/e2e/**/*.ts",
    "scripts/specifications/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
