{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-ustc-e2e",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "exports": {
    "PublicSsr": {
      "type": "worker",
      // `cross_version_cache` stays off deliberately. Entries are partitioned
      // per Worker version, so every deploy starts cold; sharing them across
      // versions would serve HTML rendered by a previous version with no
      // automatic invalidation. Invalidation is by `Cache-Tag` through
      // `POST /_internal/edge-cache/purge`, which hops into this entrypoint —
      // a zone purge cannot reach Workers Caching content.
      "cache": {
        "enabled": true
      }
    }
  },
  "vars": {
    // This disposable Worker keeps the production auth gate active: debug
    // credentials are enabled only by the explicit E2E_DEBUG_AUTH flag, and
    // auth-config rejects that flag when NODE_ENV is production.
    "NODE_ENV": "test",
    "APP_PUBLIC_ORIGIN": "http://localhost:3000",
    "AUTH_SECRET": "e2e-dev-secret-not-for-production",
    "E2E_DEBUG_AUTH": "1",
    "DEV_DEBUG_USERNAME": "dev-user",
    "DEV_DEBUG_NAME": "Dev User",
    "DEV_DEBUG_EMAIL": "dev-user@debug.local",
    "DEV_DEBUG_PASSWORD": "dev-debug-password",
    "DEV_ADMIN_USERNAME": "dev-admin",
    "DEV_ADMIN_NAME": "校园管理员",
    "DEV_ADMIN_EMAIL": "dev-admin@debug.local",
    "DEV_ADMIN_PASSWORD": "dev-admin-password",
    "METRICS_SECRET": "e2e-metrics-secret-not-for-production",
    "PUBLICATION_INGESTION_SECRET": "e2e-publication-ingestion-secret",
    "UPLOAD_TOTAL_QUOTA_MB": "100"
  },
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_app/*",
      "!/images/*",
      "!/static/*",
      "!/openapi.generated.json",
      "!/open-graph.png"
    ]
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": false
  },
  "alias": {
    "@better-auth/core/async_hooks": "./src/lib/cloudflare/better-auth-async-hooks.ts",
    "life-ustc-sveltekit-worker": "./.svelte-kit/cloudflare/_sveltekit.js",
    "kysely": "./src/lib/cloudflare/kysely-worker-shim.ts",
    "@better-auth/kysely-adapter/dist/bun-sqlite-dialect-DzNwOpKv.mjs": "./src/lib/cloudflare/empty-optional-module.ts",
    "@better-auth/kysely-adapter/dist/d1-sqlite-dialect-C2B7YsIT.mjs": "./src/lib/cloudflare/empty-optional-module.ts",
    "@better-auth/kysely-adapter/dist/node-sqlite-dialect.mjs": "./src/lib/cloudflare/empty-optional-module.ts"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local"
    },
    {
      "binding": "HYPERDRIVE_AUTH",
      "id": "local-auth"
    },
    {
      "binding": "HYPERDRIVE_MAINTENANCE",
      "id": "local-maintenance"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CALENDAR_EXPORTS",
      "id": "c7411aac14fa45a6bb6f8b8f6b8e1a1d"
    },
    {
      "binding": "CATALOG_DETAIL_CORE",
      "id": "cd40f139a6c14613adba65dc294dc168"
    }
  ],
  "ratelimits": [
    {
      "name": "USER_WRITE_RATE_LIMITER",
      "namespace_id": "414001",
      "simple": {
        "limit": 10000,
        "period": 60
      }
    },
    {
      "name": "USER_BATCH_WRITE_RATE_LIMITER",
      "namespace_id": "414002",
      "simple": {
        "limit": 10000,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_UPLOADS",
      "bucket_name": "life-ustc"
    },
    {
      "binding": "R2_PUBLICATIONS",
      "bucket_name": "life-ustc-publications"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CALENDAR_EXPORT_REBUILD",
        "queue": "life-ustc-calendar-export-rebuild"
      },
      {
        "binding": "AUDIT_LOG_WRITES",
        "queue": "life-ustc-audit-log-write"
      }
    ],
    "consumers": [
      {
        "queue": "life-ustc-calendar-export-rebuild",
        "max_batch_size": 5,
        "max_retries": 3,
        "dead_letter_queue": "life-ustc-calendar-export-rebuild-dlq"
      },
      {
        "queue": "life-ustc-audit-log-write",
        "max_batch_size": 20,
        "max_retries": 5,
        "dead_letter_queue": "life-ustc-audit-log-write-dlq"
      }
    ]
  }
}
