[Unit]
Description=Static snapshot importer containers
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@STATIC_IMPORT_REPO@
Environment=STATIC_IMPORT_IMAGE=life-ustc-static-import:local
ExecStart=/usr/bin/docker compose -f @STATIC_IMPORT_REPO@/deploy/static-import/compose.yml up --detach --remove-orphans
ExecStop=/usr/bin/docker compose -f @STATIC_IMPORT_REPO@/deploy/static-import/compose.yml stop

[Install]
WantedBy=multi-user.target
