{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-ustc",
  "preview_urls": false,
  "workers_dev": false,
  "main": "src/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "exports": {
    "PublicSsr": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    }
  },
  "vars": {
    "NODE_ENV": "production",
    "APP_PUBLIC_ORIGIN": "https://life-ustc.tiankaima.dev",
    "R2_ACCOUNT_ID": "3488b7b4f9cb9b6088c87dc44e88859e",
    "R2_PUBLICATIONS_BUCKET_NAME": "life-ustc-publications"
  },
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_app/*",
      "!/images/*",
      "!/static/*",
      "!/openapi.generated.json"
    ]
  },
  "triggers": {
    "crons": ["7 */2 * * *", "23 */6 * * *", "*/20 * * * *", "*/30 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "life-ustc.tiankaima.dev",
      "zone_name": "tiankaima.dev",
      "custom_domain": true
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "limits": {
    "cpu_ms": 30000
  },
  "alias": {
    "life-ustc-sveltekit-worker": "./.svelte-kit/cloudflare/_sveltekit.js",
    "kysely": "./src/lib/cloudflare/kysely-worker-shim.ts",
    "@better-auth/kysely-adapter/dist/bun-sqlite-dialect-DzNwOpKv.mjs": "./src/lib/cloudflare/empty-optional-module.ts",
    "@better-auth/kysely-adapter/dist/d1-sqlite-dialect-C2B7YsIT.mjs": "./src/lib/cloudflare/empty-optional-module.ts",
    "@better-auth/kysely-adapter/dist/node-sqlite-dialect.mjs": "./src/lib/cloudflare/empty-optional-module.ts"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "84d80963a096419cb1f1c9846f164bf1",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/life_ustc_dev"
    },
    {
      "binding": "HYPERDRIVE_AUTH",
      "id": "b7f9049677d44b47881f5ceccb45d890",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/life_ustc_dev"
    },
    {
      "binding": "HYPERDRIVE_MAINTENANCE",
      "id": "ad3117a4ce234e2387cf44522b65a7d9",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/life_ustc_dev"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "life_ustc_runtime"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CALENDAR_EXPORTS",
      "id": "c7411aac14fa45a6bb6f8b8f6b8e1a1d"
    },
    {
      "binding": "CATALOG_DETAIL_CORE",
      "id": "cd40f139a6c14613adba65dc294dc168"
    },
    {
      "binding": "WEATHER",
      "id": "6966f79ed6b3409580abc67daf1f403b"
    }
  ],
  "ratelimits": [
    {
      "name": "USER_WRITE_RATE_LIMITER",
      "namespace_id": "414001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "USER_BATCH_WRITE_RATE_LIMITER",
      "namespace_id": "414002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_UPLOADS",
      "bucket_name": "life-ustc"
    },
    {
      "binding": "R2_PUBLICATIONS",
      "bucket_name": "life-ustc-publications"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CALENDAR_EXPORT_REBUILD",
        "queue": "life-ustc-calendar-export-rebuild"
      },
      {
        "binding": "AUDIT_LOG_WRITES",
        "queue": "life-ustc-audit-log-write"
      }
    ],
    "consumers": [
      {
        "queue": "life-ustc-calendar-export-rebuild",
        "max_batch_size": 5,
        "max_retries": 3,
        "dead_letter_queue": "life-ustc-calendar-export-rebuild-dlq"
      },
      {
        "queue": "life-ustc-audit-log-write",
        "max_batch_size": 20,
        "max_retries": 5,
        "dead_letter_queue": "life-ustc-audit-log-write-dlq"
      }
    ]
  }
}
