{
  "name": "life-ustc-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "USTC Life Server - Course and schedule management API using SvelteKit",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13 <1.4"
  },
  "overrides": {
    "@better-auth/core": "1.7.0-rc.4",
    "@better-auth/oauth-provider": "1.7.0-rc.4",
    "@hono/node-server": "1.19.15",
    "better-auth": "1.7.0-rc.4",
    "body-parser": "2.3.0",
    "cookie": "0.7.2",
    "fast-uri": "3.1.5",
    "graphql": "16.14.2",
    "hono": "4.12.34",
    "immutable": "5.1.8",
    "ip-address": "10.3.1",
    "nanoid": "5.1.16",
    "playwright-core": "1.62.1",
    "postcss": "8.5.23"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "build": "bun run openapi:generate && vite build",
    "app:prepare": "svelte-kit sync && prisma generate",
    "svelte:sync": "svelte-kit sync",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "static:load": "bun run src/static-loader/cli.ts",
    "e2e:server": "wrangler dev --config wrangler.e2e.jsonc --ip 127.0.0.1 --port 3000 --local",
    "e2e:test": "bash tests/ci/e2e-full-suite-parity.sh",
    "e2e:test:parallel": "bash tests/ci/e2e-parallel-local.sh",
    "e2e:test:shard1": "playwright test --shard=1/4",
    "e2e:test:shard2": "playwright test --shard=2/4",
    "e2e:test:shard3": "playwright test --shard=3/4",
    "e2e:test:shard4": "playwright test --shard=4/4",
    "rest:test": "playwright test --config playwright.api.config.ts",
    "e2e:visual": "VISUAL_REGRESSION=1 playwright test visual-matrix",
    "e2e:visual:update": "VISUAL_REGRESSION=1 playwright test visual-matrix --update-snapshots",
    "hooks:install": "git config core.hooksPath .githooks",
    "openapi:generate": "bun run scripts/openapi/generate.ts",
    "openapi:check": "bun run openapi:generate && git diff --exit-code public/openapi.generated.json",
    "release": "semantic-release"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.0-rc.4",
    "@better-auth/core": "1.7.0-rc.4",
    "@better-auth/mcp": "1.7.0-rc.4",
    "@better-auth/oauth-provider": "1.7.0-rc.4",
    "@better-auth/passkey": "1.7.0-rc.6",
    "@escape.tech/graphql-armor": "3.2.0",
    "@ethercorps/sveltekit-og": "4.3.0",
    "@graphql-tools/executor": "1.5.7",
    "@graphql-yoga/plugin-disable-introspection": "2.22.2",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.31.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@scalar/api-reference": "^1.65.1",
    "better-auth": "1.7.0-rc.4",
    "clsx": "^2.1.1",
    "dataloader": "2.2.3",
    "dayjs": "^1.11.21",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "graphql": "16.14.2",
    "graphql-yoga": "5.21.2",
    "ical-generator": "^10.2.0",
    "jose": "^6.2.9",
    "katex": "^0.18.4",
    "pinyin-pro": "^3.29.2",
    "prisma": "7.9.1",
    "rehype-attr": "^4.1.3",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "3.2.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.4.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "^8.20.0",
    "bits-ui": "^2.18.1",
    "mode-watcher": "^1.1.0",
    "semantic-release": "24.2.9",
    "shadcn-svelte": "1.5.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vitest": "^4.1.10",
    "wrangler": "4.113.0",
    "zod-openapi": "^6.0.1"
  },
  "patchedDependencies": {
    "@better-auth/cimd@1.7.0-rc.4": "patches/@better-auth%2Fcimd@1.7.0-rc.4.patch"
  }
}
