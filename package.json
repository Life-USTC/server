{
  "name": "life-ustc-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "USTC Life Server - Course and schedule management API using SvelteKit",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13 <1.4"
  },
  "overrides": {
    "@better-auth/core": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@hono/node-server": "1.19.15",
    "better-auth": "1.7.10",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.5",
    "graphql": "16.14.2",
    "hono": "4.12.34",
    "immutable": "5.1.8",
    "ip-address": "10.7.4",
    "nanoid": "5.1.16",
    "playwright-core": "1.64.1",
    "postcss": "8.5.29"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "build": "bun run app:prepare && bun run openapi:generate && vite build",
    "build:test-worker": "rm -rf .svelte-kit/test-worker && NODE_ENV=development wrangler deploy --dry-run --minify --config wrangler.e2e.jsonc --outdir \"$PWD/.svelte-kit/test-worker\" && cp tests/ci/fixtures/prebuilt-worker-entry.mjs .svelte-kit/test-worker/entry.mjs",
    "app:prepare": "svelte-kit sync && prisma generate",
    "svelte:sync": "svelte-kit sync",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "static:load": "bun run src/static-loader/cli.ts",
    "e2e:test": "playwright test",
    "rest:test": "playwright test --config playwright.api.config.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "check": "bun run app:prepare && bunx wrangler types --include-runtime=false --check && bunx biome check && bun run specs:check && bunx svelte-check --tsconfig ./tsconfig.json && bunx tsc --noEmit -p tsconfig.typecheck.json && bunx tsc --noEmit -p tsconfig.typecheck.tests.json && bunx vitest run && bun run openapi:check",
    "openapi:generate": "bun run scripts/openapi/generate.ts",
    "openapi:check": "bun run scripts/openapi/generate.ts --check",
    "release": "semantic-release",
    "specs:check": "bun run scripts/specifications/cli.ts check",
    "specs:list": "bun run scripts/specifications/cli.ts list",
    "specs:show": "bun run scripts/specifications/cli.ts show"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.10",
    "@better-auth/core": "1.7.10",
    "@better-auth/mcp": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@better-auth/passkey": "1.7.10",
    "@escape.tech/graphql-armor": "3.2.0",
    "@graphql-tools/executor": "2.1.0",
    "@graphql-yoga/plugin-disable-introspection": "2.25.6",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.59.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@scalar/api-reference": "^1.75.0",
    "better-auth": "1.7.10",
    "clsx": "^2.1.1",
    "dataloader": "2.2.3",
    "dayjs": "^1.11.23",
    "diff": "^9.0.0",
    "dotenv": "^18.0.8",
    "esm-env": "^1.2.2",
    "graphql": "16.14.2",
    "graphql-yoga": "5.24.6",
    "ical-generator": "^11.1.2",
    "ip-address": "10.7.4",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "pinyin-pro": "^3.29.5",
    "prisma": "7.10.1",
    "rehype-attr": "^4.1.3",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "3.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "^1.64.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "^8.20.0",
    "bits-ui": "^2.19.5",
    "devalue": "6.0.3",
    "mode-watcher": "^1.1.0",
    "pg": "8.23.1",
    "semantic-release": "25.0.9",
    "shadcn-svelte": "1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.1",
    "wrangler": "4.151.1",
    "yaml": "2.9.1",
    "zod-openapi": "^6.0.2"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "patchedDependencies": {
    "pg-cloudflare@1.4.1": "patches/pg-cloudflare@1.4.1.patch"
  }
}
